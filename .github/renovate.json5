{
	// ref: https://docs.renovatebot.com/configuration-options/
	$schema: "https://docs.renovatebot.com/renovate-schema.json",
	extends: ["github>risu729/renovate-config#3.20.1"],
	packageRules: [
		{
			// the shared preset pins versions, but a pinned peer dependency
			// forces consumers onto one exact typescript version
			matchDepTypes: ["peerDependencies"],
			rangeStrategy: "widen",
		},
	],
}
