amends "https://raw.githubusercontent.com/risu729/hk-config/v3.1.0/presets.pkl"

import "https://raw.githubusercontent.com/risu729/hk-config/v3.1.0/helpers.pkl"

local picked =
  helpers.pick(new Listing {
    "oxlint"
    "oxfmt"
    "tsc"
    "github-actions"
    "tombi"
    "yaml"
    "typos"
    "hygiene"
  })

// Native dependency sidecars belong to mise; formatters must not rewrite their digests.
steps = (picked) {
  ["oxfmt"] = (picked["oxfmt"]) {
    exclude = picked["oxfmt"].exclude + List(".mise/locks/**/package.json")
  }
  ["yaml"] = (picked["yaml"]) {
    steps = (picked["yaml"].steps) {
      ["yamllint"] = (picked["yaml"].steps["yamllint"]) {
        exclude = helpers.yamlLockExcludes + List(".mise/locks/**/aube-lock.yaml")
      }
      ["yamlfmt"] = (picked["yaml"].steps["yamlfmt"]) {
        exclude = helpers.yamlLockExcludes + List(".mise/locks/**/aube-lock.yaml")
      }
    }
  }
  ["typos"] = (picked["typos"]) {
    exclude = List(".mise/locks/**")
  }
}
